<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Class="Pos.ServerApp.DashboardWindow" Width="840" Height="900" Title="ModernPOS Server Dashboard">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="8">
      <TextBlock Text="Server Dashboard" FontSize="22" FontWeight="Bold"/>
      <TextBlock x:Name="CompanyText"/>
      <TextBlock x:Name="PortText"/>
      <TextBlock x:Name="DbText" TextWrapping="Wrap"/>
      <TextBlock x:Name="BackupText"/>

      <TextBlock Text="Shared Company Profile" FontWeight="Bold" Margin="0,12,0,0"/>
      <TextBlock Text="This profile is stored on the server and used by every connected client for receipts, invoices, and quotes." TextWrapping="Wrap"/>
      <TextBlock Text="Company Name" Margin="0,8,0,0"/>
      <TextBox x:Name="ProfileCompanyNameBox"/>
      <TextBlock Text="Address Line 1"/>
      <TextBox x:Name="AddressLine1Box"/>
      <TextBlock Text="Address Line 2"/>
      <TextBox x:Name="AddressLine2Box"/>
      <TextBlock Text="Phone"/>
      <TextBox x:Name="PhoneBox"/>
      <TextBlock Text="Email"/>
      <TextBox x:Name="EmailBox"/>
      <TextBlock Text="TIN / VAT / Registration No"/>
      <TextBox x:Name="TaxRegistrationBox"/>
      <TextBlock Text="Receipt Header Title"/>
      <TextBox x:Name="HeaderTitleBox"/>
      <TextBlock Text="Receipt Footer / Thank-you Message"/>
      <TextBox x:Name="ReceiptFooterBox" AcceptsReturn="True" Height="90" TextWrapping="Wrap"/>
      <TextBlock Text="Logo Scale"/>
      <ComboBox x:Name="LogoScaleBox" SelectedIndex="0">
        <ComboBoxItem Content="1x"/>
        <ComboBoxItem Content="2x"/>
        <ComboBoxItem Content="3x"/>
        <ComboBoxItem Content="4x"/>
      </ComboBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Upload Header Image" Click="UploadHeaderImage_Click"/>
        <Button Content="Clear Header Image" Click="ClearHeaderImage_Click"/>
      </StackPanel>
      <TextBlock x:Name="HeaderImageStatusText" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Upload Logo" Click="UploadLogo_Click"/>
        <Button Content="Clear Logo" Click="ClearLogo_Click"/>
      </StackPanel>
      <TextBlock x:Name="LogoStatusText" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <Button Content="Save Company Profile" Click="SaveCompanyProfile_Click"/>
        <Button Content="Reload Company Profile" Click="ReloadCompanyProfile_Click"/>
      </StackPanel>

      <Button Content="Create Backup Now" Click="Backup_Click" Margin="0,12,0,0"/>
      <TextBlock Text="Scheduled Backups" FontWeight="Bold" Margin="0,8,0,0"/>
      <CheckBox x:Name="EnableSchedule" Content="Enable daily backup"/>
      <TextBox x:Name="BackupFolder" Watermark="Backup Folder"/>
      <TextBox x:Name="RetentionBox" Text="14" Watermark="Retention Count"/>
      <Button Content="Save Schedule" Click="SaveSchedule_Click"/>
      <TextBlock Text="Restore" FontWeight="Bold" Margin="0,8,0,0"/>
      <TextBox x:Name="RestoreFileBox" Watermark="Backup file path (*.db)"/>
      <Button Content="Restore Backup" Click="Restore_Click"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</Window>
