<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Pos.Terminal.Converters"
    x:Class="Pos.Terminal.App"
    RequestedThemeVariant="Light">

  <Application.Styles>
    <FluentTheme/>
  </Application.Styles>

  <Application.Resources>
  <converters:NullableDateTimeOffsetConverter x:Key="NullableDateTimeOffsetConverter" />

    <!-- Accent -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Layout -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#d8e7ff"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#aecfff"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrushLight" Color="#ffffff"/>
  </Application.Resources>
</Application>
