<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pos.Terminal.LoginWindow"
        Width="480" Height="320"
        Title="ModernPOS Terminal - Login">
  <StackPanel Margin="20" Spacing="8">
    <TextBlock Text="Login" FontSize="24" FontWeight="Bold"/>
    <TextBlock x:Name="ServerText" Foreground="DarkSlateGray"/>

    <TextBox x:Name="LoginUserBox" Watermark="Username"/>
    <TextBox x:Name="LoginPassBox" PasswordChar="*" Watermark="Password"/>

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Back" Click="Back_Click" Width="90"/>
      <Button Content="Login" Click="Login_Click" Width="120"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" Foreground="DarkRed" TextWrapping="Wrap"/>
  </StackPanel>
</Window>
