<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pos.Terminal.Views.BackupView">
  <Border Margin="16" Padding="16" CornerRadius="8" BorderThickness="1">
    <StackPanel Spacing="10">
      <TextBlock Text="Request Backup" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Trigger a manual backup and monitor backup status." Opacity="0.75"/>

      <TextBlock Text="Backup folder" Margin="0,8,0,0"/>
      <TextBox Text="{Binding BackupFolder}" Watermark="Optional backup folder path"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh Status" Command="{Binding RefreshStatusCommand}"/>
        <Button Content="Run Backup Now" Command="{Binding RunBackupCommand}"/>
      </StackPanel>

      <TextBlock Text="Last backup time:" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding LastBackup}"/>

      <TextBlock Text="Last backup file:" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding LastBackupPath}" TextWrapping="Wrap"/>

      <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</UserControl>
