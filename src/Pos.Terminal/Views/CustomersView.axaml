<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pos.Terminal.Views.CustomersView">

  <UserControl.Styles>

    <!-- Card -->
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>

    <!-- Titles -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox.search">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- List -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#12000000" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A000000" />
    </Style>

  </UserControl.Styles>

  <Grid ColumnDefinitions="360,*" RowDefinitions="Auto,*" Margin="16">

    <!-- Header -->
    <Border Grid.ColumnSpan="2" Classes="card" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="muted"
                     Text="{Binding PickerHint}"
                     IsVisible="{Binding IsPicker}" />
          <TextBlock Classes="muted"
                     Text="Search customers, manage balances, and record payments."
                     IsVisible="{Binding IsNotPicker}" />
        </StackPanel>

        <!-- Picker actions (only in picker mode) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsPicker}">
          <Button Classes="primary"
                  Content="Select"
                  Margin="0,0,10,0"
                  Command="{Binding PickSelectedCommand}" />
          <Button Classes="ghost"
                  Content="Cancel"
                  Command="{Binding CancelPickCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- LEFT: Customer Directory -->
    <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0,0,12,0">
      <Grid RowDefinitions="Auto,Auto,*">

        <TextBox Classes="search"
                 Watermark="Search by name, phone, or email…"
                 Text="{Binding Search}"
                 Margin="0,0,0,10" />

        <!-- Count + New Customer -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Classes="muted"
                     Text="{Binding ListStatus}"
                     VerticalAlignment="Center" />

          <Button Grid.Column="1"
                  Classes="ghost"
                  Content="New Customer"
                  IsVisible="{Binding IsNotPicker}"
                  Command="{Binding NewCommand}" />
        </Grid>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Customers}"
                 SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Classes="muted" Text="{Binding PhoneLine}" />
                  <TextBlock Classes="muted" Text="{Binding EmailLine}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Top"
                           FontWeight="SemiBold"
                           Text="{Binding Balance, StringFormat=$\{0:0.00\}}"
                           Opacity="0.85" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </Grid>
    </Border>

    <!-- RIGHT: Details -->
    <Border Grid.Row="1" Grid.Column="1" Classes="card">
      <ScrollViewer>
        <StackPanel>

          <!-- Empty state -->
          <Border Classes="panel" IsVisible="{Binding IsNoSelection}" Margin="0,0,0,12">
            <TextBlock Classes="muted"
                       Text="Select a customer on the left to view or edit details."
                       TextWrapping="Wrap" />
          </Border>

          <!-- Customer details -->
          <Border Classes="panel" IsVisible="{Binding ShowEditor}" Margin="0,0,0,12"> 
            <StackPanel>

              <TextBlock Classes="h2" Text="{Binding EditorTitle}" />

              <Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Text="Name" />
                <TextBox Grid.Column="1"
                         Classes="field"
                         IsEnabled="{Binding IsNotPicker}"
                         Text="{Binding EditName}" />
              </Grid>

              <Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Text="Phone" />
                <TextBox Grid.Column="1"
                         Classes="field"
                         IsEnabled="{Binding IsNotPicker}"
                         Text="{Binding EditPhone}" />
              </Grid>

              <Grid ColumnDefinitions="120,*">
                <TextBlock VerticalAlignment="Center" Text="Email" />
                <TextBox Grid.Column="1"
                         Classes="field"
                         IsEnabled="{Binding IsNotPicker}"
                         Text="{Binding EditEmail}" />
              </Grid>

              <Border Margin="0,12,0,0"
                      Padding="10"
                      CornerRadius="10"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Balance" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Balance, StringFormat=$\{0:0.00\}}"
                             FontWeight="Bold" />
                </Grid>
              </Border>

            </StackPanel>
          </Border>

          <!-- Record Payment (normal mode only) -->
          <Border Classes="panel" IsVisible="{Binding IsNotPicker}">
            <StackPanel>
              <TextBlock Classes="h2" Text="Record Payment" />

              <Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Text="Amount" />
                <TextBox Grid.Column="1"
                         Classes="field"
                         Watermark="0.00"
                         Text="{Binding PayAmount}" />
              </Grid>

              <Grid ColumnDefinitions="120,*" Margin="0,0,0,12">
                <TextBlock VerticalAlignment="Center" Text="Method" />
                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding PayMethod}">
                  <ComboBoxItem Content="CASH" />
                  <ComboBoxItem Content="CREDIT" />
                  <ComboBoxItem Content="DEBIT" />
                  <ComboBoxItem Content="TRANSFER" />
                </ComboBox>
              </Grid>

              <StackPanel Orientation="Horizontal">
                <Button Classes="primary"
                        Content="Apply Payment"
                        Margin="0,0,10,0"
                        Command="{Binding ApplyPaymentCommand}" />
                <Button Classes="ghost"
                        Content="Clear"
                        Command="{Binding ClearPaymentCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Actions (normal mode only): New + Save + Delete -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsVisible="{Binding IsNotPicker}">
            <Button Classes="ghost"
                    Content="New"
                    Margin="0,0,10,0"
                    Command="{Binding NewCommand}" />

            <Button Classes="primary"
                    Content="Save"
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}" />

            <Button Classes="ghost"
                    Content="Delete"
                    Command="{Binding DeleteCommand}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

  </Grid>
</UserControl>
