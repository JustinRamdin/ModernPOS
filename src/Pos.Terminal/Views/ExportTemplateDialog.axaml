<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pos.Terminal.Views.ExportTemplateDialog"
        Width="1200"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Title="Export workspace">

 <Window.Styles>
    <Style Selector="DatePicker.export-date">
      <Setter Property="MinWidth" Value="250" />
    </Style>

    <Style Selector="DatePicker.export-date /template/ ComboBox#PART_MonthPicker">
      <Setter Property="Width" Value="130" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="DatePicker.export-date /template/ ComboBox#PART_DayPicker">
      <Setter Property="Width" Value="70" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="DatePicker.export-date /template/ ComboBox#PART_YearPicker">
      <Setter Property="Width" Value="90" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="12">

    <!-- Header -->
    <Border Padding="10" CornerRadius="8" BorderThickness="1" Margin="0,0,0,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding TemplateName}" />
          <TextBlock Opacity="0.75" Text="{Binding TemplateDescription}" />
        </StackPanel>

        <Button DockPanel.Dock="Right"
                Content="Export Excel"
                Click="Export_Click"
                Margin="8,0,0,0"/>
      </DockPanel>
    </Border>

    <!-- Filters -->
    <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1" Margin="0,0,0,10">
      <WrapPanel>

        <StackPanel Width="270" Margin="0,0,12,10">
          <TextBlock Text="From" />
          <DatePicker Classes="export-date"
                      SelectedDate="{Binding FromDate, Mode=TwoWay, Converter={StaticResource NullableDateTimeOffsetConverter}}" />
        </StackPanel>

        <StackPanel Width="270" Margin="0,0,12,10">
          <TextBlock Text="To" />
          <DatePicker Classes="export-date"
                      SelectedDate="{Binding ToDate, Mode=TwoWay, Converter={StaticResource NullableDateTimeOffsetConverter}}" />
        </StackPanel>

        <StackPanel Width="200" Margin="0,0,10,10">
          <TextBlock Text="Payment Type" />
          <ComboBox ItemsSource="{Binding PaymentTypes}"
                    SelectedItem="{Binding SelectedPaymentType}" />
        </StackPanel>

        <StackPanel Width="240" Margin="0,0,10,10">
          <TextBlock Text="Customer" />
          <ComboBox ItemsSource="{Binding Customers}"
                    SelectedItem="{Binding SelectedCustomer}" />
        </StackPanel>

        <StackPanel Width="240">
          <TextBlock Text="Item / SKU" />
          <ComboBox ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}" />
        </StackPanel>

        <StackPanel Width="220" Margin="0,0,10,10">
          <TextBlock Text="Search" />
          <TextBox Text="{Binding SearchText}" Watermark="receipt, customer, sku..." />
        </StackPanel>

        <StackPanel Width="120" VerticalAlignment="Bottom" Margin="0,0,10,10">
          <Button Content="Refresh"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>

      </WrapPanel>
    </Border>

    <!-- Status + Grid -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Text="{Binding Status}" Opacity="0.8" Margin="0,0,0,8"/>

      <DataGrid Grid.Row="1"
                Name="Grid"
                ItemsSource="{Binding Rows}"
                IsReadOnly="True"
                GridLinesVisibility="All"
                HeadersVisibility="All"
                AutoGenerateColumns="False"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                CanUserReorderColumns="True" />
    </Grid>

  </Grid>
</Window>
