<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Pos.Terminal.Views.ExportTemplateDialog"
        Width="920"
        Height="640"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Export Template">

  <Window.Styles>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="16">
    <StackPanel Margin="0,0,0,12">
      <TextBlock Classes="h2" Text="{Binding TemplateName}" />
      <TextBlock Classes="muted" Text="{Binding TemplateDescription}" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,0,0,12" Padding="10" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <TextBlock VerticalAlignment="Center" Text="From" />
          <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay, Converter={StaticResource NullableDateTimeOffsetConverter}}" Width="160" />
          <TextBlock VerticalAlignment="Center" Text="To" />
          <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay, Converter={StaticResource NullableDateTimeOffsetConverter}}" Width="160" />
          <Button Classes="primary" Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" />
          <Button Classes="primary" Content="Export to Excel" Click="ExportToExcel_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DataGrid Grid.Row="2"
              Name="TemplateGrid"
              ItemsSource="{Binding Rows}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column" />
  </Grid>
</Window>
