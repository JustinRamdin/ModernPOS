<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pos.Terminal.Views.FinancialItemsWindow"
        Width="760" Height="520"
        Title="Manage Items"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Text="Item Cart Editor" FontSize="20" FontWeight="Bold"/>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,10,0,10">
      <Button Grid.Column="0" Content="Search" Click="Search_Click"/>
      <TextBlock Grid.Column="1" Text="Selected:" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding SelectedProductDisplay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="Qty" VerticalAlignment="Center"/>
      <TextBox Grid.Column="4" Width="80" Text="{Binding Editor.LineQuantity, Mode=TwoWay}"/>
      <Button Grid.Column="5" Content="Add Item" HorizontalAlignment="Left" Click="AddItem_Click"/>
    </Grid>

    <Border Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="3*,Auto,Auto" Margin="4,0,4,8">
          <TextBlock Text="Description" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" Margin="12,0,0,0"/>
          <TextBlock Grid.Column="2" Text="Unit Price" FontWeight="SemiBold" Margin="12,0,0,0"/>
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Editor.Lines}" SelectedItem="{Binding Editor.SelectedLine, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="4" Margin="0,2,0,2" CornerRadius="4">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Edit Quantity" Click="EditQuantity_Click" CommandParameter="{Binding}"/>
                    <MenuItem Header="Delete" Click="DeleteLine_Click" CommandParameter="{Binding}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="3*,Auto,Auto">
                  <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Quantity}" Margin="12,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:0.00}}" Margin="12,0,0,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
      <Button Grid.Column="0" Content="Clear" Click="Clear_Click"/>
      <TextBlock Grid.Column="1" Text="Subtotal:" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding Editor.Subtotal, StringFormat={}{0:0.00}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
      <Button Grid.Column="3" Content="Cancel" Click="Cancel_Click"/>
      <Button Grid.Column="4" Content="Save" Click="Save_Click"/>
    </Grid>
  </Grid>
</Window>
