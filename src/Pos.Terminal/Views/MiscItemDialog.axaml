<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pos.Terminal.Views.MiscItemDialog"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Title="Add Miscellaneous Item">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Add Miscellaneous Item" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
    <TextBlock Text="Item name" />
    <TextBox x:Name="NameBox" Watermark="e.g. Delivery fee" />
    <TextBlock Text="Description" />
    <TextBox x:Name="DescriptionBox" Watermark="Optional details" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,*">
      <StackPanel Spacing="6">
        <TextBlock Text="Quantity" />
        <TextBox x:Name="QuantityBox" Text="1" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
        <TextBlock Text="Unit price" />
        <TextBox x:Name="PriceBox" Watermark="0.00" />
      </StackPanel>
    </Grid>
    <CheckBox x:Name="VatInclusiveBox" Content="Price includes VAT" />
    <TextBlock x:Name="ErrorText" Foreground="Red" IsVisible="False" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Add to Till" Click="Add_Click" />
    </StackPanel>
  </StackPanel>
</Window>
