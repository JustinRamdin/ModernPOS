<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pos.Terminal.Views.ReportsView">

  <UserControl.Styles>
    <!-- Card style consistent with TerminalView -->
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Border.export-card">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>

    <Style Selector="Button.export-trigger">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.export-flyout">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="MinWidth" Value="320" />
    </Style>

    <Style Selector="Button.export-flyout-action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>


        <Style Selector="Border.date-range-bar">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>

    <Style Selector="TextBlock.section-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  
    <!-- Make DatePicker segments (Month / Day / Year) tighter -->
      <Style Selector="DatePicker.compact-date /template/ ComboBox#PART_MonthPicker">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

      <Style Selector="DatePicker.compact-date /template/ ComboBox#PART_DayPicker">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

      <Style Selector="DatePicker.compact-date /template/ ComboBox#PART_YearPicker">
        <Setter Property="Width" Value="90"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

      <!-- Optional: keep text centered so it reads clean -->
      <Style Selector="DatePicker.compact-date /template/ ComboBox">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
      </Style>

    <!-- Tab spacing -->
    <Style Selector="TabControl">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="16">

    <!-- Header / toolbar -->
    <Border Classes="card" Padding="14" Margin="0,0,0,12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Classes="h1" Text="Reports" />
          <TextBlock Classes="muted" Text="Z report, profit, inventory value, movements, low stock, and customer sales." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Classes="primary" Content="Refresh All" Command="{Binding RefreshAllCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="1">

      <!-- Z REPORT / SALES -->
      <TabItem Header="Z Report">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <!-- Date range -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Date Range" />
                  
                  <Border Classes="date-range-bar">
                    <DockPanel LastChildFill="True">
                      <Grid DockPanel.Dock="Left"
                            ColumnDefinitions="Auto,280,Auto,280,Auto"
                            VerticalAlignment="Center">

                        <TextBlock Grid.Column="0" Classes="section-label"
                                  VerticalAlignment="Center" Text="From" />

                        <DatePicker Grid.Column="1"
                                    Classes="compact-date"
                                    MinWidth="280"
                                    Margin="8,0,16,0"
                                    SelectedDate="{Binding FromDate, Mode=TwoWay, Converter={StaticResource NullableDateTimeOffsetConverter}}" />

                        <TextBlock Grid.Column="2" Classes="section-label"
                                  VerticalAlignment="Center" Text="To" />

                        <DatePicker Grid.Column="3"
                                    Classes="compact-date"
                                    MinWidth="280"
                                    Margin="8,0,16,0"
                                    SelectedDate="{Binding ToDate, Mode=TwoWay, Converter={StaticResource NullableDateTimeOffsetConverter}}" />

                        <Button Grid.Column="4"
                                Classes="ghost"
                                VerticalAlignment="Center"
                                Content="{Binding DateRangeLabel}"
                                Command="{Binding ApplyDateRangeCommand}" />
                      </Grid>

                      <TextBlock DockPanel.Dock="Right"
                                Classes="muted"
                                VerticalAlignment="Center"
                                Text="Tip: adjust dates to refresh Z report data" />
                    </DockPanel>
                  </Border>

                </StackPanel>
            </Border>
            <!-- Summary cards -->
            <Grid ColumnDefinitions="*,*,*,*">
              <Border Classes="card" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Classes="muted" Text="Receipts"/>
                  <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding ReceiptCount}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Classes="muted" Text="Net"/>
                  <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding NetTotal, StringFormat='${0:0.00}'}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="card" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Classes="muted" Text="VAT"/>
                  <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding VatTotal, StringFormat='${0:0.00}'}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="3" Classes="card">
                <StackPanel>
                  <TextBlock Classes="muted" Text="Gross"/>
                  <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding GrossTotal, StringFormat='${0:0.00}'}"/>
                  <TextBlock Classes="muted" Text="{Binding AvgGross, StringFormat='Avg: ${0:0.00}'}"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Tender Breakdown -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Tender Breakdown" />

                <Grid ColumnDefinitions="*,*,*,*">
                  <TextBlock Text="{Binding CashTotal, StringFormat='Cash: ${0:0.00}'}" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding DebitTotal, StringFormat='Debit: ${0:0.00}'}" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding CreditTotal, StringFormat='Credit: ${0:0.00}'}" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="3" Text="{Binding OnAccountTotal, StringFormat='On Account: ${0:0.00}'}"/>
                </Grid>

                <TextBlock Classes="muted" Text="{Binding ChangeGiven, StringFormat='Change given: ${0:0.00}'}"/>
                <TextBlock FontWeight="Bold" Text="{Binding ExpectedCash, StringFormat='Expected cash in drawer: ${0:0.00}'}"/>
              </StackPanel>
            </Border>

            <!-- Sales by Day -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Sales by Day" />

                <Grid ColumnDefinitions="160,100,*,*,*">
                  <TextBlock Grid.Column="0" FontWeight="Bold" Opacity="0.8" Text="Date"/>
                  <TextBlock Grid.Column="1" FontWeight="Bold" Opacity="0.8" Text="Receipts"/>
                  <TextBlock Grid.Column="2" FontWeight="Bold" Opacity="0.8" Text="Net"/>
                  <TextBlock Grid.Column="3" FontWeight="Bold" Opacity="0.8" Text="VAT"/>
                  <TextBlock Grid.Column="4" FontWeight="Bold" Opacity="0.8" Text="Gross"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding SalesByDay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="160,100,*,*,*" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{Binding Day}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ReceiptCount}"/>
                        <TextBlock Grid.Column="2" Text="{Binding NetTotal, StringFormat='${0:0.00}'}"/>
                        <TextBlock Grid.Column="3" Text="{Binding VatTotal, StringFormat='${0:0.00}'}"/>
                        <TextBlock Grid.Column="4" Text="{Binding GrossTotal, StringFormat='${0:0.00}'}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            
            <!-- Sales Log -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Sales Log" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding SalesSearchText, Mode=TwoWay}" Watermark="Search receipt or item..." />
                  <Button Grid.Column="1" Classes="ghost" Content="Search" Command="{Binding ApplyDateRangeCommand}" />
                </Grid>
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                  <ListBox ItemsSource="{Binding SalesLog}" SelectedItem="{Binding SelectedSale, Mode=TwoWay}" Height="220">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="6">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding ReceiptNo}" />
                            <TextBlock Classes="muted" Text="{Binding SoldAtUtc}" />
                            <TextBlock Text="{Binding Total, StringFormat='Total: ${0:0.00}'}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Refund" Click="RefundSale_Click" />
                        <MenuItem Header="Reprint" Click="ReprintSale_Click" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                  </ListBox>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Refund Item" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding SelectedSaleLines}" SelectedItem="{Binding SelectedRefundLine, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding ProductName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding RefundQuantity, Mode=TwoWay}" Watermark="Qty" />
                    <Button Content="Submit Refund" Click="SubmitRefund_Click" />
                    <TextBlock Classes="muted" Text="Right click a sale to refund or reprint." />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            
            <!-- Top Products -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Top Products (by Gross)" />

                <Grid ColumnDefinitions="120,*,120,140">
                  <TextBlock Grid.Column="0" FontWeight="Bold" Opacity="0.8" Text="SKU"/>
                  <TextBlock Grid.Column="1" FontWeight="Bold" Opacity="0.8" Text="Item"/>
                  <TextBlock Grid.Column="2" FontWeight="Bold" Opacity="0.8" Text="Qty"/>
                  <TextBlock Grid.Column="3" FontWeight="Bold" Opacity="0.8" Text="Gross"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding TopProducts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="120,*,120,140" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{Binding Sku}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}"/>
                        <TextBlock Grid.Column="3" Text="{Binding GrossTotal, StringFormat='${0:0.00}'}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- PROFIT -->
      <TabItem Header="Profit">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Profit Summary" />
                <TextBlock Text="{Binding SalesGross, StringFormat='Sales (Gross): ${0:0.00}'}"/>
                <TextBlock Text="{Binding Cogs, StringFormat='COGS: ${0:0.00}'}"/>
                <TextBlock FontWeight="Bold" Text="{Binding GrossProfit, StringFormat='Gross Profit: ${0:0.00}'}"/>

                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="muted" Text="{Binding GrossMarginPct}"/>
                  <TextBlock Classes="muted" Text="%" />
                </StackPanel>

                <TextBlock Classes="muted" Margin="0,6,0,0"
                           Text="Note: COGS uses current Product.CostPrice. For historical cost accuracy, store cost on SaleLine at sale time."/>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Profit by Product" />

                <Grid ColumnDefinitions="120,*,120,120,120">
                  <TextBlock Grid.Column="0" FontWeight="Bold" Opacity="0.8" Text="SKU"/>
                  <TextBlock Grid.Column="1" FontWeight="Bold" Opacity="0.8" Text="Item"/>
                  <TextBlock Grid.Column="2" FontWeight="Bold" Opacity="0.8" Text="Qty"/>
                  <TextBlock Grid.Column="3" FontWeight="Bold" Opacity="0.8" Text="Profit"/>
                  <TextBlock Grid.Column="4" FontWeight="Bold" Opacity="0.8" Text="Margin"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding ProfitByProduct}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="120,*,120,120,120" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{Binding Sku}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}"/>
                        <TextBlock Grid.Column="3" Text="{Binding GrossProfit, StringFormat='${0:0.00}'}"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding GrossMarginPct}"/>
                          <TextBlock Text="%"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- INVENTORY -->
      <TabItem Header="Inventory Value">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <Border Classes="card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" Text="Location" Margin="0,0,8,0"/>
                  <TextBox Width="160" Text="{Binding LocationCode}" Watermark="DEFAULT"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Content="Refresh" Command="{Binding RefreshInventoryCommand}"/>
              </DockPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="120,*,110,140,140,140">
                  <TextBlock Grid.Column="0" FontWeight="Bold" Opacity="0.8" Text="SKU"/>
                  <TextBlock Grid.Column="1" FontWeight="Bold" Opacity="0.8" Text="Item"/>
                  <TextBlock Grid.Column="2" FontWeight="Bold" Opacity="0.8" Text="On hand"/>
                  <TextBlock Grid.Column="3" FontWeight="Bold" Opacity="0.8" Text="Sell value"/>
                  <TextBlock Grid.Column="4" FontWeight="Bold" Opacity="0.8" Text="Cost value"/>
                  <TextBlock Grid.Column="5" FontWeight="Bold" Opacity="0.8" Text="Margin"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding InventoryValuation}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="120,*,110,140,140,140" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{Binding Sku}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding OnHandDisplay}"/>
                        <TextBlock Grid.Column="3" Text="{Binding SellingValue, StringFormat='${0:0.00}'}"/>
                        <TextBlock Grid.Column="4" Text="{Binding CostValue, StringFormat='${0:0.00}'}"/>
                        <TextBlock Grid.Column="5" Text="{Binding EstimatedGrossMargin, StringFormat='${0:0.00}'}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- MOVEMENTS -->
      <TabItem Header="Movements">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <Border Classes="card">
              <TextBlock Classes="muted" Text="Movements include sales (negative) and manual adjustments (from outbox inventory_adjustment)." />
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="180,80,120,*,120">
                  <TextBlock Grid.Column="0" FontWeight="Bold" Opacity="0.8" Text="Time (UTC)"/>
                  <TextBlock Grid.Column="1" FontWeight="Bold" Opacity="0.8" Text="Type"/>
                  <TextBlock Grid.Column="2" FontWeight="Bold" Opacity="0.8" Text="SKU"/>
                  <TextBlock Grid.Column="3" FontWeight="Bold" Opacity="0.8" Text="Reason"/>
                  <TextBlock Grid.Column="4" FontWeight="Bold" Opacity="0.8" Text="Delta"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding InventoryMovements}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="180,80,120,*,120" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{Binding OccurredAtUtc}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Type}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Sku}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Reason}"/>
                        <TextBlock Grid.Column="4" Text="{Binding DeltaDisplay}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- LOW STOCK -->
      <TabItem Header="Low Stock">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <Border Classes="card">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" Text="Location" Margin="0,0,8,0"/>
                  <TextBox Width="140" Text="{Binding LocationCode}" Watermark="DEFAULT" Margin="0,0,14,0"/>

                  <TextBlock VerticalAlignment="Center" Text="Lookback days" Margin="0,0,8,0"/>
                  <TextBox Width="60" Text="{Binding LookbackDays}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Content="Refresh" Command="{Binding RefreshLowStockCommand}"/>
              </DockPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="120,*,110,140,140,140">
                  <TextBlock Grid.Column="0" FontWeight="Bold" Opacity="0.8" Text="SKU"/>
                  <TextBlock Grid.Column="1" FontWeight="Bold" Opacity="0.8" Text="Item"/>
                  <TextBlock Grid.Column="2" FontWeight="Bold" Opacity="0.8" Text="On hand"/>
                  <TextBlock Grid.Column="3" FontWeight="Bold" Opacity="0.8" Text="Avg/day (base)"/>
                  <TextBlock Grid.Column="4" FontWeight="Bold" Opacity="0.8" Text="Days left"/>
                  <TextBlock Grid.Column="5" FontWeight="Bold" Opacity="0.8" Text="Reorder (base)"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding LowStock}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="120,*,110,140,140,140" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{Binding Sku}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding OnHandDisplay}"/>
                        <TextBlock Grid.Column="3" Text="{Binding AvgDailyUsageBase}"/>
                        <TextBlock Grid.Column="4" Text="{Binding DaysRemaining}"/>
                        <TextBlock Grid.Column="5" Text="{Binding SuggestedReorderBase}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CUSTOMERS -->
      <TabItem Header="Customers">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <Border Classes="card">
              <TextBlock Classes="muted" Text="Sales by customer for the selected date range (uses Sale.CustomerId)." />
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,120,140,140">
                  <TextBlock Grid.Column="0" FontWeight="Bold" Opacity="0.8" Text="Customer"/>
                  <TextBlock Grid.Column="1" FontWeight="Bold" Opacity="0.8" Text="Receipts"/>
                  <TextBlock Grid.Column="2" FontWeight="Bold" Opacity="0.8" Text="Gross"/>
                  <TextBlock Grid.Column="3" FontWeight="Bold" Opacity="0.8" Text="Balance"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding CustomerSales}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,120,140,140" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{Binding CustomerName}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ReceiptCount}"/>
                        <TextBlock Grid.Column="2" Text="{Binding GrossTotal, StringFormat='${0:0.00}'}"/>
                        <TextBlock Grid.Column="3" Text="{Binding CurrentBalance, StringFormat='${0:0.00}'}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

            <!-- EXPORT -->
      <TabItem Header="Export">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Export Templates" />
                <TextBlock Classes="muted" Text="Select a template to preview data, filter by period, and export to Excel." />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ExportTemplates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                 <Border Classes="export-card" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <TextBlock Grid.Column="0"
                                 Grid.Row="0"
                                 FontWeight="SemiBold"
                                 FontSize="15"
                                 Text="{Binding Name}" />

                      <Border Grid.Column="1"
                              Grid.Row="0"
                              CornerRadius="999"
                              Padding="10,2"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <TextBlock Classes="muted" Text="Template" />
                      </Border>

                      <TextBlock Grid.ColumnSpan="2"
                                 Grid.Row="1"
                                 Classes="muted"
                                 Text="{Binding Description}" />

                      <StackPanel Grid.ColumnSpan="2"
                                  Grid.Row="2"
                                  Orientation="Horizontal"
                                  Spacing="10">
                        <Button Classes="export-trigger"
                                Content="Open Actions ▾"
                                Tag="{Binding}"
                                Click="OpenExportTemplate_Click">
                          <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                              <Border Classes="export-flyout">
                                <StackPanel Spacing="2">
                                  <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                  <TextBlock Classes="muted"
                                             Margin="0,0,0,8"
                                             Text="Choose how you want to open this report." />

                                  <Button Classes="primary export-flyout-action"
                                          Content="Open full export workspace"
                                          Tag="{Binding}"
                                          Click="OpenExportWorkspace_Click" />

                                  <TextBlock Classes="section-label" Margin="0,8,0,6" Text="Quick period actions" />

                                  <Button Classes="export-flyout-action"
                                          Content="Open with Last 7 Days"
                                          Tag="{Binding}"
                                          Click="OpenExportLast7Days_Click" />

                                  <Button Classes="export-flyout-action"
                                          Content="Open with This Month"
                                          Tag="{Binding}"
                                          Click="OpenExportThisMonth_Click" />

                                  <Separator Margin="0,8,0,8" />
                                  <TextBlock Classes="muted" Text="Tip: quick actions update the report date range before opening." />
                                </StackPanel>
                              </Border>
                            </Flyout>
                          </FlyoutBase.AttachedFlyout>
                        </Button>
                      </StackPanel>
                       </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
