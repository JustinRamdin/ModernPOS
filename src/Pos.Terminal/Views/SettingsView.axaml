<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pos.Terminal.Views.SettingsView">
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="24">
      <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"/>

      <TabControl>
        <TabItem Header="General">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="Receipt Printer"/>
            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"/>
            <CheckBox Content="Print all receipts in TSP style"
                      IsChecked="{Binding UseTspReceiptStyle}"/>
            <TextBlock Text="{Binding PrinterStatus}" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <Button Content="Refresh Printers" Click="RefreshPrinters_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </TabItem>

        <TabItem Header="Company Profile">
          <StackPanel Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="Shared business identity" FontWeight="Bold"/>
            <TextBlock Text="{Binding CompanyProfileStatus}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>

            <TextBlock Text="Company Name" Margin="0,8,0,0"/>
            <TextBox Text="{Binding SharedCompanyName}" IsReadOnly="True"/>

            <TextBlock Text="Address"/>
            <TextBox Text="{Binding SharedAddress}" IsReadOnly="True" AcceptsReturn="True" Height="70"/>

            <TextBlock Text="Contact"/>
            <TextBox Text="{Binding SharedContact}" IsReadOnly="True"/>

            <TextBlock Text="Tax / Registration"/>
            <TextBox Text="{Binding SharedTaxRegistrationNumber}" IsReadOnly="True"/>

            <TextBlock Text="Header Title"/>
            <TextBox Text="{Binding SharedHeaderTitle}" IsReadOnly="True"/>

            <TextBlock Text="Receipt Footer"/>
            <TextBox Text="{Binding SharedReceiptFooter}" IsReadOnly="True" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

            <Button Content="Refresh from Server" Click="RefreshSharedProfile_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </TabItem>

        <TabItem Header="Finance">
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <TextBlock Text="Finance options for this terminal only." Foreground="{DynamicResource SecondaryTextBrush}"/>

            <CheckBox Content="Enable VAT in terminal"
                      IsChecked="{Binding IsVatEnabled}"/>

            <TextBlock Text="VAT Rate (%)"/>
            <TextBox Text="{Binding VatRatePercent}" Watermark="12.5" Width="120" HorizontalAlignment="Left"/>
          </StackPanel>
        </TabItem>
      </TabControl>

      <StackPanel Spacing="8">
        <TextBlock Text="Practice Mode" FontWeight="Bold"/>
        <TextBlock Text="{Binding PracticeModeStatus}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        <Button Content="{Binding PracticeModeButtonText}" Click="TogglePracticeMode_Click" HorizontalAlignment="Left"/>
      </StackPanel>
      
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Save Settings" Click="Save_Click"/>
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
