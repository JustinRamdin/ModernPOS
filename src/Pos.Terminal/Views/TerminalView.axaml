<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    x:Class="Pos.Terminal.Views.TerminalView">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

  <Style Selector="Border.toast">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

 <Grid RowDefinitions="Auto,*" Margin="16">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Classes="h1" Text="Terminal" />
        <TextBlock Classes="muted" Text="Fast sales-entry checkout" />
      </StackPanel>

      <Border Grid.Column="1" Classes="toast" IsVisible="{Binding IsToastVisible}" Margin="12,2,0,0">
        <TextBlock Text="{Binding ToastMessage}" />
      </Border>
    </Grid>

     <Grid Grid.Row="1" ColumnDefinitions="3.8*,2.2*">
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Classes="h2" Text="Sales Entry" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="ghost" Content="Search Item" Command="{Binding AddSearchItemCommand}" />
            <Button Grid.Column="2" Classes="ghost" Content="Add Misc" Click="AddMisc_Click" Margin="10,0,0,0" />
            <Button Grid.Column="3" Classes="ghost" Content="Notes" Click="Notes_Click"
                    IsEnabled="{Binding IsCustomerSelected}" Margin="10,0,0,0" />
          </Grid>
        <Grid Grid.Row="1">
            <TextBlock IsVisible="{Binding IsCartEmpty}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No items added" />

            <dg:DataGrid
                x:Name="CartGrid"
                IsVisible="{Binding IsCartNotEmpty}"
                ItemsSource="{Binding CartLines}"
                SelectedItem="{Binding SelectedCartLine}"
                AutoGenerateColumns="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                IsReadOnly="True">
              <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Item #" Binding="{Binding ItemNumber}" Width="120" />
                <dg:DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="180" />
                <dg:DataGridTextColumn Header="Item Description" Binding="{Binding ItemDescription}" Width="2*" />
                <dg:DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" />
                <dg:DataGridTextColumn Header="Qty" Binding="{Binding QuantityValue, StringFormat={}{0:0.###}}" Width="90" />
                <dg:DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, StringFormat={}{0:0.00}}" Width="110" />
                <dg:DataGridTextColumn Header="Ext Price" Binding="{Binding ExtendedPrice, StringFormat={}{0:0.00}}" Width="110" />
                <dg:DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat={}{0:0.00}}" Width="90" />
              </dg:DataGrid.Columns>
            </dg:DataGrid>
          </Grid>
        </Grid>
      </Border>

        <Border Grid.Column="1" Classes="card" Margin="12,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border CornerRadius="12" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Background="#FFE3E3E3">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock Classes="muted" Text="Customer" />
                <TextBlock Text="{Binding SelectedCustomerLabel}" FontWeight="SemiBold" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="Select" Click="SelectCustomer_Click" Margin="0,0,10,0" />
              <Button Grid.Column="2" Classes="ghost" Content="Clear" Click="ClearCustomer_Click" />
            </Grid>
</Border>

          <Border Grid.Row="2" CornerRadius="12" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Background="#FFE3E3E3">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Subtotal" /><TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=$\{0:0.00\}}" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Discount" /><TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat=-$\{0:0.00\}}" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="VAT" /><TextBlock Grid.Column="1" Text="{Binding VatTotal, StringFormat=$\{0:0.00\}}" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock FontWeight="Bold" Text="Total Due" /><TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding TotalDue, StringFormat=$\{0:0.00\}}" /></Grid>

              <Button Classes="primary" Content="Pay" IsEnabled="{Binding IsCartNotEmptyAndCustomerSelected}" Click="Pay_Click" />

              <Grid ColumnDefinitions="*,*,*,*">
                <Button Classes="ghost" Content="Discount" Click="Discount_Click" Margin="0,0,10,0" />
                <Button Classes="ghost" Grid.Column="1" Content="Clear" Click="Clear_Click" Margin="0,0,10,0" />
                <Button Classes="ghost" Grid.Column="2" Content="Checkout (Cash)" Click="CashCheckout_Click" Margin="0,0,10,0" IsEnabled="{Binding IsCartNotEmptyAndCustomerSelected}" />
                <Button Classes="ghost" Grid.Column="3" Content="Open Drawer" Command="{Binding OpenDrawerCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>
