<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pos.Terminal.Views.UpdatesView">
  <ScrollViewer>
    <Border Margin="16" Padding="16" CornerRadius="8" BorderThickness="1">
      <StackPanel Spacing="12">
        <TextBlock Text="Updates" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Install terminal-only updates from a local folder. This flow never performs server upgrades or database migrations." Opacity="0.75" TextWrapping="Wrap"/>

        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="Current client version" FontWeight="SemiBold" Margin="0,0,12,8"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentClientVersion}" Margin="0,0,0,8"/>

          <TextBlock Grid.Row="1" Text="Connected server version" FontWeight="SemiBold" Margin="0,0,12,8"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectedServerVersion}" Margin="0,0,0,8"/>

          <TextBlock Grid.Row="2" Text="Selected local update folder" FontWeight="SemiBold" Margin="0,0,12,8"/>
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedUpdateFolder}" IsReadOnly="True" Watermark="Choose a USB, network share, or local downloads folder" Margin="0,0,0,8"/>

          <TextBlock Grid.Row="3" Text="Available update version" FontWeight="SemiBold" Margin="0,0,12,0"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AvailableUpdateVersion}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Browse" Click="BrowseFolder_Click"/>
          <Button Content="Check for Updates Locally" Command="{Binding CheckLocalUpdatesCommand}"/>
          <Button Content="Install Update" Command="{Binding InstallUpdateCommand}"/>
          <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Padding="12" CornerRadius="6" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Release Notes" FontWeight="Bold"/>
            <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Padding="12" CornerRadius="6" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Compatibility / Warning" FontWeight="Bold"/>
            <TextBlock Text="{Binding CompatibilitySummary}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding WarningSummary}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Padding="12" CornerRadius="6" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Safety rules" FontWeight="Bold"/>
            <TextBlock Text="• Only client-only packages can be installed here." TextWrapping="Wrap"/>
            <TextBlock Text="• Server updates, schema changes, and migrations stay manual." TextWrapping="Wrap"/>
            <TextBlock Text="• Live inventory data must remain outside the app install folder." TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
